---
interface Props {
  brandName?: string;
  brandEdit?: Record<string, string>;
  homeHref?: string;
  plateHref?: string;
  typesHref?: string;
  readingsHref?: string;
  questionsHref?: string;
  chartHref?: string;
}

const {
  brandName = "Nine Centres",
  brandEdit = {},
  homeHref = "#top",
  plateHref = "#plate",
  typesHref = "#types",
  readingsHref = "#readings",
  questionsHref = "#faq",
  chartHref = "#chart",
} = Astro.props;
---

<header class="hd-header" data-hd-header>
  <a href={homeHref} class="brand-link" data-brand-link {...brandEdit}>
    {brandName}
  </a>
  <nav class="nav-links" aria-label="Primary Navigation">
    <a href={plateHref} class="nav-link">Plate</a>
    <a href={typesHref} class="nav-link">Types</a>
    <a href={readingsHref} class="nav-link">Readings</a>
    <a href={questionsHref} class="nav-link">Questions</a>
  </nav>
  <a href={chartHref} class="cta-btn" data-cta-btn>
    <span class="cta-label">Free bodygraph</span>
    <span class="cta-dot" aria-hidden="true"></span>
  </a>
</header>

<style>
  .hd-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 86px;
    z-index: 50;
    height: 100vh;
    background: #16100D;
    color: #F0E7DB;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 26px 0 22px;
    border-right: 1px solid #33291F;
  }

  .brand-link {
    font-family: var(--font-display);
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-weight: 700;
    font-size: 19px;
    letter-spacing: -0.01em;
    color: #F0E7DB;
    text-decoration: none;
  }

  .brand-link:hover {
    color: #D8F546;
  }

  .nav-links {
    display: flex;
    flex-direction: column-reverse;
    align-items: center;
    gap: 30px;
  }

  .nav-link {
    font-family: var(--font-sans);
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #9A8E82;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .nav-link:hover {
    color: #D8F546;
  }

  .cta-btn {
    font-family: var(--font-sans);
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    color: #16100D;
    text-decoration: none;
  }

  .cta-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .cta-dot { width: 9px; height: 9px; border-radius: 50%; background: #D8F546; transition: transform .2s ease, background .2s ease; }
  .cta-btn:hover .cta-dot { transform: scale(1.6); background: #E2603D; }

  .hd-header a:focus-visible {
    outline: 2px solid #D8F546;
    outline-offset: 5px;
  }

  @media (max-width: 768px) {
    .hd-header {
      position: sticky;
      left: auto;
      width: 100%;
      height: auto;
      min-height: 64px;
      flex-direction: row;
      padding: 12px 18px;
      border-right: 0;
      border-bottom: 1px solid #33291F;
    }
    .brand-link, .nav-link { writing-mode: initial; transform: none; }
    .brand-link { font-size: 17px; }
    .nav-links { display: none; }
    .cta-btn { width: auto; height: 38px; padding: 0 14px; background: #D8F546; }
    .cta-label { position: static; width: auto; height: auto; overflow: visible; clip: auto; font-size: 10px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
    .cta-dot { display: none; }
  }
</style>
