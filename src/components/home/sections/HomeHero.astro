---
interface Props {
  dateline?: string;
  body?: string;
  kickerEdit?: Record<string, string>;
  titleEdit?: Record<string, string>;
  bodyEdit?: Record<string, string>;
  subtext?: string;
  subtextEdit?: Record<string, string>;
  sideNote?: string;
  sideNoteEdit?: Record<string, string>;
}

const {
  dateline = "Charts read by hand · one at a time",
  body = "A map of how you are built to decide, drawn from your birth date, time and place. Nothing here forecasts events.",
  kickerEdit = {},
  titleEdit = {},
  bodyEdit = {},
  subtext = "Coloured centres are consistent in you. Open ones are where you absorb everyone else. Start with the free chart, decide about a reading after.",
  subtextEdit = {},
  sideNote = "Every chart on this page is drawn and read by one person, in plain language, and the recording stays yours.",
  sideNoteEdit = {},
} = Astro.props;
---

<section class="home-hero" data-home-hero>
  <div class="hero-utility">
    <p class="hero-dateline" data-hero-dateline {...kickerEdit}>{dateline}</p>
    <div class="hero-utility-action">
      <span>No. 07</span>
      <a href="#chart">Free bodygraph</a>
    </div>
  </div>
  <div class="hero-intro">
    <p class="hero-kicker">Filed under — how you decide</p>
  <h1 class="hero-title" data-hero-title {...titleEdit}>
      Your chart already knows how you were built to <span class="accent-text">decide.</span>
  </h1>
  </div>

  <div class="hero-grid">
    <div class="hero-col-main">
      <p class="lead-text" {...bodyEdit}>{body}</p>
      <p class="sub-text" {...subtextEdit}>{subtext}</p>
      <p class="side-note" {...sideNoteEdit}>{sideNote}</p>

      <div class="hero-stats">
        <div class="stat-card stat-1">
          <p class="stat-number">1,400+</p>
          <p class="stat-label">Charts read</p>
        </div>
        <div class="stat-card stat-2">
          <p class="stat-number">75 min</p>
          <p class="stat-label">Standard session</p>
        </div>
        <div class="stat-card stat-3">
          <p class="stat-number accent-num">Yours</p>
          <p class="stat-label">Recording to keep</p>
        </div>
      </div>
    </div>
    <div class="hero-generator">
      <slot name="generator" />
    </div>
  </div>
</section>

<style>
  .home-hero {
    min-height: calc(100svh - 1px);
    background-color: #16100D;
    background-image: linear-gradient(90deg, rgba(240, 231, 219, .035) 0 1px, transparent 1px 100%);
    background-size: 132px 100%;
    color: #F0E7DB;
    padding: 0 48px 84px;
  }

  .hero-utility {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin: 0 -48px;
    padding: 14px 48px;
    border-bottom: 1px solid #33291F;
  }

  .hero-dateline, .hero-utility-action span, .hero-utility-action a, .hero-kicker {
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  .hero-dateline { color: #9A8E82; margin: 0; }
  .hero-utility-action { display: flex; align-items: center; gap: 18px; }
  .hero-utility-action span { color: #6E6157; }
  .hero-utility-action a { padding: 7px 14px; background: #D8F546; color: #16100D; transition: background .2s ease; }
  .hero-utility-action a:hover { background: #E2603D; }
  .hero-intro { padding-top: 64px; }
  .hero-kicker { margin: 0 0 30px; color: #E2603D; letter-spacing: .28em; }

  .hero-title {
    max-width: 20ch;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(48px, 7.2vw, 112px);
    line-height: .9;
    letter-spacing: -.035em;
    text-wrap: balance;
  }

  .accent-text {
    color: #D8F546;
    font-family: var(--font-editorial);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -.01em;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(320px, .9fr);
    gap: 64px;
    margin-top: 52px;
    align-items: start;
  }

  .hero-col-main {
    min-width: 0;
  }

  .lead-text {
    max-width: 44ch;
    font-size: 20px;
    line-height: 1.55;
    margin: 0 0 20px;
    text-wrap: pretty;
  }

  .sub-text {
    max-width: 52ch;
    font-size: 16.5px;
    line-height: 1.68;
    color: #B6A99B;
    margin: 0 0 18px;
    text-wrap: pretty;
  }

  .side-note {
    max-width: 52ch;
    font-size: 16.5px;
    line-height: 1.68;
    color: #B6A99B;
    margin: 0;
    text-wrap: pretty;
  }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    align-items: flex-end;
    gap: 0;
    margin-top: 44px;
    border-top: 1px solid #33291F;
  }

  .stat-card {
    min-width: 0;
    padding: 20px 22px 0 0;
    border-right: 1px solid #33291F;
  }

  .stat-1 { margin-bottom: 0; }
  .stat-2, .stat-3 { margin-bottom: 0; padding-left: 22px; }
  .stat-3 { border-right: 0; }

  .stat-number {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 38px;
    line-height: 1;
    letter-spacing: -0.03em;
    margin: 0 0 8px;
  }

  .stat-number.accent-num {
    color: #D8F546;
  }

  .stat-label {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #9A8E82;
    margin: 0;
  }

  .hero-generator {
    min-width: 0;
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-col-main, .hero-generator { min-width: 0; }
    .hero-stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
    }
    .stat-card { min-width: 0; }
  }

  @media (max-width: 640px) {
    .home-hero {
      min-height: auto;
      padding: 0 20px 42px;
    }
    .hero-utility { display: none; }
    .hero-intro { padding-top: 44px; }
    .hero-title { font-size: clamp(46px, 14vw, 72px); }
    .hero-grid { margin-top: 42px; gap: 24px; }
    .hero-stats { grid-template-columns: 1fr; }
    .stat-card, .stat-2, .stat-3 { padding: 18px 0; border-right: 0; border-bottom: 1px solid #33291F; }
    .stat-3 { border-bottom: 0; }
  }
</style>
