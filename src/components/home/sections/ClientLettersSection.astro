---
import { TESTIMONIALS } from "../../../data/human-design.constants.ts";

const { eyebrow = "Letters from clients", eyebrowEdit = {} } = Astro.props;
---

<section class="client-letters-section" data-client-letters-section>
  <p class="letters-eyebrow" {...eyebrowEdit}>{eyebrow}</p>
  <div class="letters-grid">
    {TESTIMONIALS.map((t, i) => (
      <figure class={`testimonial-card test-card-${i + 1}`}>
        <blockquote class="testimonial-quote">
          {t.quote}
        </blockquote>
        <figcaption class="testimonial-author">
          {t.author}
        </figcaption>
      </figure>
    ))}
  </div>
</section>

<style>
  .client-letters-section {
    margin-top: 104px;
    background: #D8F546;
    color: #F0E7DB;
    padding: 64px 32px;
  }

  .letters-eyebrow {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: #E2603D;
    margin: 0 0 44px;
  }

  .letters-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    align-items: start;
  }

  .testimonial-card {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .test-card-1 { padding-top: 0; }
  .test-card-2 { padding-top: 40px; }
  .test-card-3 { padding-top: 80px; }

  .testimonial-quote {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(17px, 1.7vw, 23px);
    line-height: 1.3;
    letter-spacing: -0.04em;
    margin: 0;
    text-wrap: pretty;
  }

  .testimonial-author {
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #B6A99B;
  }

  @media (max-width: 900px) {
    .letters-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .test-card-2, .test-card-3 {
      padding-top: 0;
    }
  }

  @media (max-width: 640px) {
    .client-letters-section {
      padding: 48px 20px;
    }
  }

  /* Dusk Spine theme */
  .client-letters-section { margin-top: 0; background: #1F1815; color: #F0E7DB; border-block: 1px solid #33291F; }
  .letters-grid { border-top: 1px solid #4A3E36; padding-top: 34px; }
  .testimonial-card { border-right: 1px solid #33291F; padding-right: 34px; }
  .testimonial-card:last-child { border-right: 0; }
  .testimonial-author { color: #9A8E82; }
</style>
