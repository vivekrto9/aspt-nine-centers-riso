---
import { TYPES } from "../../../data/human-design.constants.ts";

const { eyebrow = "The five types", title = "Everybody is one of five", hint = "Open a column to read its strategy", eyebrowEdit = {}, titleEdit = {}, hintEdit = {} } = Astro.props;
---

<section id="types" class="five-types-section" data-five-types-section>
  <div class="section-header-grid">
    <div class="section-heading-cluster">
      <span class="section-number">03</span>
      <div class="section-title-wrap">
        <p class="section-eyebrow" {...eyebrowEdit}>{eyebrow}</p>
        <h2 class="section-heading" {...titleEdit}>{title}</h2>
      </div>
    </div>
    <p class="section-hint" {...hintEdit}>{hint}</p>
  </div>

  <div class="types-container" data-types-container>
    {TYPES.map((type, index) => (
      <div class={`type-column type-column-${index + 1}${index === 1 ? " is-open" : ""}`} data-type-index={index}>
        <button type="button" class="type-trigger" data-type-trigger={index} aria-expanded={index === 1 ? "true" : "false"} style={index === 1 ? "display:none" : "display:flex"}>
          <span class="type-num">{type.num}</span>
          <span class="type-title">{type.name}</span>
          <span class="type-share">{type.share}</span>
        </button>

        <div class="type-reading" data-type-content={index} style={index === 1 ? "display:flex" : "display:none"}>
          <div class="reading-header">
            <span class="reading-num">{type.num}</span>
            <span class="reading-share">{type.share} of people</span>
          </div>
          <h3 class="reading-title">{type.name}</h3>
          <p class="reading-body">{type.body}</p>
          <div class="reading-specs">
            <div class="spec spec-first">
              <p class="spec-label">Strategy</p>
              <p class="spec-value">{type.strategy}</p>
            </div>
            <div class="spec">
              <p class="spec-label">Signature</p>
              <p class="spec-value">{type.signature}</p>
            </div>
            <div class="spec spec-last">
              <p class="spec-label">Not-self</p>
              <p class="spec-value">{type.notSelf}</p>
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<script is:inline>
  (() => {
    const section = document.querySelector("[data-five-types-section]");
    if (!section) return;
    const columns = section.querySelectorAll("[data-type-index]");

    section.querySelectorAll("[data-type-trigger]").forEach((button) => {
      button.addEventListener("click", () => {
        const selectedIndex = button.getAttribute("data-type-trigger");
        columns.forEach((column) => {
          const isSelected = column.getAttribute("data-type-index") === selectedIndex;
          const trigger = column.querySelector("[data-type-trigger]");
          const content = column.querySelector("[data-type-content]");
          column.classList.toggle("is-open", isSelected);
          if (trigger) {
            trigger.style.display = isSelected ? "none" : "flex";
            trigger.setAttribute("aria-expanded", String(isSelected));
          }
          if (content) content.style.display = isSelected ? "flex" : "none";
        });
      });
    });
  })();
</script>

<style>
  .five-types-section { padding: 0 48px 96px; background: #16100D; color: #F0E7DB; }
  .section-header-grid { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 20px; margin-bottom: 38px; }
  .section-heading-cluster { display: flex; align-items: flex-start; gap: 30px; }
  .section-number { flex: none; color: transparent; font-family: var(--font-display); font-size: 104px; font-weight: 700; line-height: .76; letter-spacing: -.05em; -webkit-text-stroke: 1px #4A3E36; }
  .section-title-wrap { padding-top: 8px; }
  .section-eyebrow { margin: 0 0 12px; color: #E2603D; font-size: 10.5px; font-weight: 600; letter-spacing: .26em; text-transform: uppercase; }
  .section-heading { margin: 0; font-family: var(--font-display); font-size: 40px; font-weight: 600; line-height: 1.02; letter-spacing: -.032em; }
  .section-hint { margin: 0; color: #6E6157; font-size: 9.5px; font-weight: 600; letter-spacing: .2em; text-align: right; text-transform: uppercase; }

  .types-container { display: flex; align-items: stretch; gap: 6px; min-height: 440px; }
  .type-column { flex: 0 0 78px; min-width: 0; overflow: hidden; border: 0; border-top: 2px solid #33291F; background: #1F1815; transition: flex-basis 350ms ease, flex-grow 350ms ease, background-color 180ms ease; }
  .type-column.is-open { flex: 1 1 auto; border-top-color: transparent; background: #D8F546; }

  .type-trigger { width: 100%; height: 100%; flex-direction: column; align-items: center; justify-content: space-between; gap: 18px; padding: 22px 0; border: 0; background: transparent; color: #F0E7DB; cursor: pointer; text-align: center; transition: background-color 150ms ease; }
  .type-trigger:hover { background: transparent; }
  .type-trigger:focus-visible { outline: 2px solid #D8F546; outline-offset: -3px; }
  .type-num { color: #6E6157; font-size: 10.5px; font-weight: 600; letter-spacing: .14em; }
  .type-title { color: #F0E7DB; font-family: var(--font-display); font-size: 20px; font-weight: 500; letter-spacing: -.01em; white-space: nowrap; writing-mode: vertical-rl; transform: rotate(180deg); }
  .type-share { color: #9A8E82; font-size: 11px; font-weight: 600; }

  .type-reading { height: 100%; flex-direction: column; padding: 32px 34px 30px; color: #16100D; }
  .reading-header { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; margin-bottom: 20px; }
  .reading-num, .reading-share { color: rgb(22 16 13 / 55%); font-size: 10.5px; font-weight: 600; letter-spacing: .2em; }
  .reading-share { text-transform: uppercase; }
  .reading-title { margin: 0 0 20px; color: #16100D; font-family: var(--font-display); font-size: clamp(34px, 4.2vw, 60px); font-weight: 700; line-height: .94; letter-spacing: -.038em; text-wrap: balance; }
  .reading-body { max-width: 40ch; margin: 0 0 auto; color: #2B2018; font-size: 19px; line-height: 1.5; text-wrap: pretty; }
  .reading-specs { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 32px; border-top: 1px solid rgb(22 16 13 / 28%); }
  .spec { padding: 18px 18px 0; border-right: 1px solid rgb(22 16 13 / 18%); }
  .spec-first { padding-left: 0; }
  .spec-last { padding-right: 0; border-right: 0; }
  .spec-label { margin: 0 0 8px; color: rgb(22 16 13 / 60%); font-size: 9.5px; font-weight: 600; letter-spacing: .2em; text-transform: uppercase; }
  .spec-value { margin: 0; color: #16100D; font-size: 16px; line-height: 1.4; }

  @media (max-width: 900px) {
    .five-types-section { padding: 72px 20px; }
    .section-header-grid { align-items: flex-start; }
    .section-heading-cluster { gap: 18px; }
    .section-number { font-size: 76px; }
    .section-heading { font-size: clamp(30px, 8vw, 40px); }
    .section-hint { width: 100%; text-align: left; }
    .types-container { flex-direction: column; min-height: 0; }
    .type-column, .type-column.is-open { flex: none; width: 100%; }
    .type-trigger { min-height: 76px; flex-direction: row; padding: 18px 20px; text-align: left; }
    .type-title { flex: 1; writing-mode: initial; transform: none; }
    .type-reading { min-height: 430px; padding: 28px 24px; }
  }

  @media (max-width: 620px) {
    .section-heading-cluster { display: block; }
    .section-number { display: block; margin-bottom: 24px; }
    .type-reading { min-height: 0; }
    .reading-specs { grid-template-columns: 1fr; }
    .spec, .spec-first, .spec-last { padding: 14px 0; border-right: 0; border-bottom: 1px solid rgb(22 16 13 / 18%); }
    .spec-last { border-bottom: 0; }
  }

  @media (prefers-reduced-motion: reduce) { .type-column { transition: none; } }
</style>
